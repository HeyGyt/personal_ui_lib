            function List:Set(Value)
                if List.Multi then
                    if type(Value) ~= "table" then
                        return
                    end

                    List.Value = Value

                    for _, Option in Value do
                        local OptionData = List.Options[Option]

                        if not OptionData then
                            continue
                        end

                        OptionData.IsSelected = true
                        OptionData:ToggleState("Active")
                    end

                    Flags[List.Flag] = Value
                else
                    if not List.Options[Value] then
                        return
                    end

                    local OptionData = List.Options[Value]

                    List.Value = Value

                    for _, Option in List.Options do
                        if Option ~= OptionData then
                            Option.IsSelected = false
                            Option:ToggleState("Inactive")
                        else
                            Option.IsSelected = true
                            Option:ToggleState("Active")
