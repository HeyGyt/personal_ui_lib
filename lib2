            Items["KeybindWindow"]:VisibleCheck()

            function Keybind:UpdateFlag()
                Flags[Keybind.Flag] = {
                    Mode = Keybind.Mode,
                    Key = Keybind.Key,
                    Toggled = Keybind.Toggled
                }
            end

            -- // keybind list registration (backfill-safe)
            local KeybindObject

            local UpdateList = function()
                if KeybindObject then
                    KeybindObject:Set(Data.Name, Keybind.Mode, Keybind.Value)
                    KeybindObject:SetStatus(Keybind.Toggled)
                end
            end

            local ModeDropdown = Library:Dropdown({
                Name = "Mode",
                Flag = Keybind.Flag .. "ModeDropdown",
                Parent = Items["KeybindWindow"],
                Items = { "Toggle", "Hold", "Always" },
                Default = "Toggle",
                Callback = function(Value)
                    Keybind.Mode = Value
                    Keybind:UpdateFlag()

                    if Data.Callback then
                        Library:SafeCall(Data.Callback, Keybind.Toggled)
                    end

                    if Value == "Always" then
                        Keybind:Press(true)
                    end

                    UpdateList()
                end
            })

            local ShowInKeybindsList = Library:Toggle({
                Name = "Show in keybinds list",
                Flag = Keybind.Flag .. "ShowInKeybindsList",
                Parent = Items["KeybindWindow"],
                Default = true,
                Callback = function(Value)
                    if KeybindObject then
                        KeybindObject:SetVis(Value)
                        UpdateList()
                    end
                end
            })

            function Keybind:RegisterToList()
                if KeybindObject then
                    return
                end

                if not Library.KeyList then
                    return
                end

                if Data.Name == "Menu Keybind" then
                    return
                end

                KeybindObject = Library.KeyList:Add(Data.Name, Keybind.Mode, Keybind.Value)
                KeybindObject:SetVis(ShowInKeybindsList.Value)
                UpdateList()
            end

            TableInsert(Library.Keybinds, Keybind)

            function Keybind:Press(Bool)
                if Keybind.Mode == "Toggle" then
                    Keybind.Toggled = not Keybind.Toggled
                elseif Keybind.Mode == "Hold" then
                    Keybind.Toggled = Bool
                elseif Keybind.Mode == "Always" then
                    Keybind.Toggled = true
                end

                Keybind:UpdateFlag()

                if Data.Callback then
                    Library:SafeCall(Data.Callback, Keybind.Toggled)
                end

                UpdateList()
            end

            function Keybind:Set(Key)
                -- config table: {Key = ..., Mode = ...}
                if type(Key) == "table" then
                    Keybind.Mode = Key.Mode or "Toggle"

                    if Key.Key then
                        Keybind:Set(Key.Key)
                    else
                        Keybind:UpdateFlag()
                        UpdateList()
                    end
                    return
                end

                -- mode-only set
                if Key == "Toggle" or Key == "Hold" or Key == "Always" then
                    Keybind.Mode = Key
                    Keybind:UpdateFlag()

                    if Data.Callback then
                        Library:SafeCall(Data.Callback, Keybind.Toggled)
                    end

                    UpdateList()
                    return
                end

                local KeyString = tostring(Key)

                -- plain names ("E", "MouseButton1") or empty
                if not StringFind(KeyString, "Enum") then
                    if KeyString == "" or KeyString == "none" then
                        Keybind.Key = ""
                        Keybind.Value = "none"
                        Items["KeyButton"].Instance.Text = "none"
                        Keybind:UpdateFlag()
                        UpdateList()
                        Keybind.Picking = false
                        return
                    end

                    local Resolved
                    local Ok1, Res1 = pcall(function() return Enum.KeyCode[KeyString] end)
                    if Ok1 then Resolved = Res1 end

                    if not Resolved then
                        local Ok2, Res2 = pcall(function() return Enum.UserInputType[KeyString] end)
                        if Ok2 then Resolved = Res2 end
                    end

                    if not Resolved then
                        Keybind.Picking = false
                        return
                    end

                    KeyString = tostring(Resolved)
                end

                -- backspace = unbind
                if KeyString == "Enum.KeyCode.Backspace" then
                    Keybind.Key = ""
                    Keybind.Value = "none"
                    Items["KeyButton"].Instance.Text = "none"
                    Keybind:UpdateFlag()

                    if Data.Callback then
                        Library:SafeCall(Data.Callback, Keybind.Toggled)
                    end

                    UpdateList()
                    Keybind.Picking = false
                    return
                end

                Keybind.Key = KeyString
                Keybind.Value = GetKeyDisplay(KeyString)
                Items["KeyButton"].Instance.Text = StringLower(Keybind.Value)

                Keybind:UpdateFlag()

                if Data.Callback then
                    Library:SafeCall(Data.Callback, Keybind.Toggled)
                end

                UpdateList()
                Keybind.Picking = false
            end

            Items["KeyButton"]:Connect("MouseButton1Click", function()
                if Keybind.Picking then
                    return
                end

                Keybind.Picking = true
                Items["KeyButton"].Instance.Text = ". . ."

                local InputBegan
                InputBegan = UserInputService.InputBegan:Connect(function(Input)
                    if Input.UserInputType == Enum.UserInputType.Keyboard then
                        Keybind:Set(Input.KeyCode)
                    else
                        Keybind:Set(Input.UserInputType)
                    end

                    InputBegan:Disconnect()
                    InputBegan = nil
                end)
            end)

            Library:Connect(UserInputService.InputBegan, function(Input, GPE)
                if not GPE and not Keybind.Picking and Keybind.Key ~= "" then
                    local IsKeyMatch = Input.UserInputType == Enum.UserInputType.Keyboard and tostring(Input.KeyCode) == Keybind.Key
                    local IsMouseMatch = tostring(Input.UserInputType) == Keybind.Key

                    if IsKeyMatch or IsMouseMatch then
                        if Keybind.Mode == "Toggle" then
                            Keybind:Press()
                        elseif Keybind.Mode == "Hold" then
                            Keybind:Press(true)
                        elseif Keybind.Mode == "Always" then
                            Keybind:Press(true)
                        end
                    end
                end

                if Input.UserInputType == Enum.UserInputType.MouseButton1 and Keybind.IsOpen then
                    if not Items["KeybindWindow"]:IsMouseOverFrame() and not ModeDropdown.Items.OptionHolder:IsMouseOverFrame() then
                        Keybind:SetOpen(false)
                    end
                end
            end)

            Library:Connect(UserInputService.InputEnded, function(Input, GPE)
                if GPE then
                    return
                end

                if Keybind.Key == "" then
                    return
                end

                if tostring(Input.KeyCode) == Keybind.Key or tostring(Input.UserInputType) == Keybind.Key then
                    if Keybind.Mode == "Hold" then
                        Keybind:Press(false)
                    elseif Keybind.Mode == "Always" then
                        Keybind:Press(true)
                    end
                end
            end)

            Items["KeyButton"]:Connect("MouseButton2Down", function()
                Keybind:SetOpen(not Keybind.IsOpen)
            end)

            if Data.Default then
                Keybind:Set({
                    Mode = Data.Mode or "Toggle",
                    Key = Data.Default,
                })
            end

            SetFlags[Keybind.Flag] = function(Value)
                Keybind:Set(Value)
            end

            Keybind:RegisterToList()

            return Keybind, Items
        end

