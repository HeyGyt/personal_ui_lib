                for _, Value in List.Options do
                    List:Remove(Value.Name)
                end

                for _, Value in NewList do
                    List:Add(Value)
                end
            end

            function List:SetVisibility(Bool)
                Items["List"].Instance.Visible = Bool
            end

            for _, Value in List.OptionItems do
