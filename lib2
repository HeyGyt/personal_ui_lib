    -- // custom font (handles writefile / getcustomasset failures)
    local CustomFont = { } do
        local FALLBACK_FONT = Enum.Font.Code

        function CustomFont:New(Name, Weight, Style, Data)
            local RawPath = StringFormat("%s/%s.ttf", Library.Directory .. Library.Folders.Assets, Name)
            local FontJsonPath = StringFormat("%s/%s.font", Library.Directory .. Library.Folders.Assets, Name)

            if not isfile(RawPath) then
                local Ok, Err = pcall(function()
                    writefile(RawPath, game:HttpGet(Data.Url))
                end)

                if not Ok then
                    warn("[jarvis] Failed to download font '" .. Name .. "': " .. tostring(Err))
                    return FALLBACK_FONT
                end
            end

            local Manifest = {
                name = Name,
                faces = {
                    {
                        name = Name,
                        weight = Weight,
                        style = Style,
                        assetId = getcustomasset(RawPath)
                    }
                }
            }

            local WriteOk = pcall(function()
                writefile(FontJsonPath, HttpService:JSONEncode(Manifest))
            end)

            if not WriteOk then
                warn("[jarvis] Failed to write font manifest for '" .. Name .. "'")
                return FALLBACK_FONT
            end

            local Ok, FontOrErr = pcall(function()
                return Font.new(getcustomasset(FontJsonPath))
            end)

            if not Ok or not FontOrErr then
                warn("[jarvis] getcustomasset failed for '" .. Name .. "', falling back")
                return FALLBACK_FONT
            end

            return FontOrErr
        end

        Library.Font = CustomFont:New("TahomaXP", 400, "Regular", {
            Id = "TahomaXP",
