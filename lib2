    Library.PopupPosition = function(Self, Anchor, Popup, ExtraY)
        local Scale = Library:GetScreenScale()
        ExtraY = ExtraY or 0

        -- holder uses IgnoreGuiInset, AbsolutePosition is already gui space (the old + GuiInset pushed popups ~58px too low)
        return UDim2FromOffset(
            Anchor.AbsolutePosition.X / Scale,
            (Anchor.AbsolutePosition.Y + Anchor.AbsoluteSize.Y + ExtraY) / Scale
        )
    end

    Library.VisibleCheck = function(Self)
