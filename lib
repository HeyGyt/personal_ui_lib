function Lib:Watermark(text)
	local W = {}
	local template = tostring(text or "NovaUI | {fps} fps")
	local f = New("Frame", { Parent = Lib.Holder, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.new(0, 0, 0, 22), AutomaticSize = AutoX }, { BackgroundColor3 = "Background" })
	Stroke(f, "Outline")
	New("Frame", { Parent = f, Size = UDim2.new(1, 0, 0, 2) }, { BackgroundColor3 = "Accent" })
	local lbl = New("TextLabel", { Parent = f, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = AutoX, Text = (template:gsub("{fps}", "--")) }, { TextColor3 = "Text" })
	Pad(lbl, 2, 8, 0, 8)
	Draggable(f, f)

	function W:SetText(t) template = tostring(t); lbl.Text = (template:gsub("{fps}", "--")) end
	function W:SetVisible(b) f.Visible = b end

	local n, t0 = 0, os.clock()
	Connect(RunService.RenderStepped, function()
		n += 1
		local now = os.clock()
		if now - t0 >= 0.5 then
			local fps = math.floor(n / (now - t0) + 0.5)
			n, t0 = 0, now
			if template:find("{fps}", 1, true) then lbl.Text = (template:gsub("{fps}", tostring(fps))) end
		end
	end)

	Lib._watermark = W
	return W
end

function Lib:KeybindList()
	local L = { rows = {} }
	local f = New("Frame", { Parent = Lib.Holder, Position = UDim2.new(0, 10, 0.5, -40), Size = UDim2.new(0, 0, 0, 0), AutomaticSize = AutoXY }, { BackgroundColor3 = "Background" })
	Stroke(f, "Outline")
	New("UISizeConstraint", { Parent = f, MinSize = Vector2.new(140, 0) })
	Layout(f, 2)
	Pad(f, 4, 8, 6, 8)
	New("TextLabel", { Parent = f, Size = UDim2.new(0, 0, 0, 16), AutomaticSize = AutoX, Text = "Keybinds", LayoutOrder = 0 }, { TextColor3 = "Accent" })
	Draggable(f, f)

	Lib._RefreshBinds = function()
		for _, r in L.rows do r:Destroy() end
		L.rows = {}
		for idx, K in Lib._binds do
			if K.Active and K.ShowInList and K.Mode ~= "None" then
				local key = K.Key and K.Key.Name or "-"
				table.insert(L.rows, New("TextLabel", { Parent = f, Size = UDim2.new(0, 0, 0, 14), AutomaticSize = AutoX, Text = K.Name .. " [" .. key .. "] " .. K.Mode, LayoutOrder = idx }, { TextColor3 = "Text" }))
			end
		end
	end
	function L:SetVisible(b) f.Visible = b end

	Lib._klist = L
	Lib._RefreshBinds()
	return L
end

return Lib
