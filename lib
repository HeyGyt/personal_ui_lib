function Tab:Section(name, side)
	local right = side == 2 or (type(side) == "string" and side:lower() == "right")
	local col = right and self.Right or self.Left
	local f = New("Frame", { Parent = col, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AutoY }, { BackgroundColor3 = "Inline" })
	Stroke(f, "Outline")
	New("TextLabel", { Parent = f, Position = UDim2.fromOffset(8, 3), Size = UDim2.new(1, -16, 0, 16), Text = name or "Section" }, { TextColor3 = "Accent" })
	New("Frame", { Parent = f, Position = UDim2.fromOffset(0, 21), Size = UDim2.new(1, 0, 0, 1) }, { BackgroundColor3 = "Outline" })
	local content = New("Frame", { Parent = f, BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 29), Size = UDim2.new(1, -16, 0, 0), AutomaticSize = AutoY })
	Layout(content, 6)
	Pad(content, 0, 0, 8, 0)
	return setmetatable({ Content = content, Order = 0, Tab = self }, Section)
end

function Tab:Select()
	local w = self.Window
	if w.Current then
		w.Current.Page.Visible = false
		Bind(w.Current.Button, "TextColor3", "Dim")
	end
	w.Current = self
	self.Page.Visible = true
	Bind(self.Button, "TextColor3", "Accent")
end

function Window:Tab(name)
	local t = setmetatable({ Window = self }, Tab)
	t.Page = New("Frame", { Parent = self._content, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false })
	local function column(pos)
		local c = New("ScrollingFrame", { Parent = t.Page, Position = pos, Size = UDim2.new(0.5, -12, 1, 0), ScrollBarThickness = 2, AutomaticCanvasSize = AutoY, CanvasSize = UDim2.new() },
			{ ScrollBarImageColor3 = "Accent" })
		Layout(c, 12)
		Pad(c, 10, 3, 8, 3)
		return c
	end
	t.Left = column(UDim2.fromOffset(8, 0))
	t.Right = column(UDim2.new(0.5, 4, 0, 0))
	t.Button = New("TextButton", { Parent = self._tabs, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = AutoX, Text = name or "Tab" }, { TextColor3 = "Dim" })
	t.Button.MouseButton1Click:Connect(function() t:Select() end)
	if not self.Current then t:Select() end
	return t
end

function Window:Toggle() self.Main.Visible = not self.Main.Visible end
function Window:SetVisible(b) self.Main.Visible = b end

function Window:SettingsTab(name)
	local tab = self:Tab(name or "Settings")

	local menu = tab:Section("Menu", 1)
	menu:Keybind({ Name = "Menu key", Flag = "_MenuKey", Default = Lib.ToggleKey, Mode = "None",
		Changed = function(k) if k then Lib.ToggleKey = k end end })
	menu:Toggle({ Name = "Watermark", Flag = "_Watermark", Default = true, Callback = function(v) if Lib._watermark then Lib._watermark:SetVisible(v) end end })
	menu:Toggle({ Name = "Keybind list", Flag = "_KeybindList", Default = true, Callback = function(v) if Lib._klist then Lib._klist:SetVisible(v) end end })
	menu:Button("Unload UI", function() Lib:Unload() end)

	local cf = tab:Section("Configs", 1)
	local nameBox = cf:Textbox({ Name = "Config name", Flag = "_CfgName", NoSave = true, Placeholder = "my config" })
	local dd = cf:Dropdown({ Name = "Configs", Flag = "_CfgList", NoSave = true, Items = Lib:GetConfigs() })
	local function pick()
		local n = nameBox.Value
		if n == "" or n == nil then n = dd.Value end
		return n
	end
	local function result(ok, err, okMsg)
		Lib:Notify(ok and okMsg or ("Failed: " .. tostring(err)), 3, ok and nil or Color3.fromRGB(255, 70, 70))
		dd:Refresh(Lib:GetConfigs())
	end
	cf:Button("Save", function() local n = pick() if n then local ok, err = Lib:SaveConfig(n) result(ok, err, "Saved " .. n) end end)
	cf:Button("Load", function() local n = pick() if n then local ok, err = Lib:LoadConfig(n) result(ok, err, "Loaded " .. n) end end)
	cf:Button("Delete", function() local n = pick() if n then local ok, err = Lib:DeleteConfig(n) result(ok, err, "Deleted " .. n) end end)

	local th = tab:Section("Theme", 2)
	for _, k in { "Accent", "Background", "Inline", "Outline", "Border", "Text", "Dim", "Element", "Hover" } do
		th:Colorpicker({ Name = k, Flag = "Theme_" .. k, Default = Lib.Theme[k], Callback = function(c) Lib:SetTheme(k, c) end })
	end
	return tab
end

function Lib:Window(o)
	if type(o) ~= "table" then o = { Title = o } end
	local w = setmetatable({}, Window)
	if o.ToggleKey then Lib.ToggleKey = o.ToggleKey end

	local main = New("Frame", { Parent = Lib.Holder, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(o.Width or 540, o.Height or 380) }, { BackgroundColor3 = "Background" })
	Stroke(main, "Outline")
	local bar = New("Frame", { Parent = main, Size = UDim2.new(1, 0, 0, 28) }, { BackgroundColor3 = "Inline" })
	New("TextLabel", { Parent = bar, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0, 0, 1, 0), AutomaticSize = AutoX, Text = o.Title or "Window" }, { TextColor3 = "Accent" })
	New("Frame", { Parent = main, Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 1) }, { BackgroundColor3 = "Accent" })
	local tabs = New("Frame", { Parent = bar, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0), Size = UDim2.new(0, 0, 1, 0), AutomaticSize = AutoX })
	Layout(tabs, 12, true, true)
	local content = New("Frame", { Parent = main, BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 29), Size = UDim2.new(1, 0, 1, -29), ClipsDescendants = true })
	Draggable(bar, main)

	w.Main, w._tabs, w._content = main, tabs, content
	table.insert(Lib._windows, w)
	return w
end

